# =====================================================================
# MUAC - Plantilla de Variables de Entorno (.env.example)
# =====================================================================
# Copia este archivo a .env y completa los valores correspondientes:
#   cp .env.example .env
#   chmod 600 .env
# =====================================================================

# 1. Credenciales de Google OAuth (Antigravity)
# Obtenidas de la consola de Google Cloud o del cliente oficial de Antigravity
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 2. Persistencia en Memoria de Lodane (Opcional)
# Token de acceso para el servidor MCP de Lodane
token=

# 3. Configuración del Servidor
PORT=3000
NODE_ENV=production
